// Resource budget for a full TACC Lonestar6 compute node (128 cores, 256 GB RAM,
// 288 GB node-local SSD at /tmp, $SCRATCH on BeeGFS).
//
// Use with: -profile conda,lonestar6  |  -profile apptainer,lonestar6
//           -profile docker,lonestar6
//
// DESIGN PRINCIPLE
//   A larger allocation buys more task CONCURRENCY, not more threads per task.
//   Every per-process `cpus` here is therefore the SAME as in
//   conf/default.config; what changes is `maxForks`. This is deliberate: for
//   human STAR alignment MEMORY, not CPU, is the limiting resource, so the way a
//   256 GB node earns its speedup is by aligning more libraries at once, not by
//   widening each alignment past the point where it scales.
//
//   The one exception is STAR_INDEX, which runs once, is not part of any
//   throughput pipeline, and simply benefits from headroom.
//
//   WORKLOAD CAVEAT: this profile cannot be demonstrated by a 1- or 3-library
//   run. Three matched pairs produce only six genome alignments total, so even at
//   maxForks = 4 the node never approaches saturation. Use conf/default.config
//   for reproducible small-scale benchmarks and reserve this profile for panels
//   of ~25 libraries or more, where the speedup comes from concurrency.
//
// SELECTOR ORDER / MATCHING
//   Same rules and same selector inventory as conf/default.config; only maxForks
//   and STAR_INDEX / DEEPTOOLS_BAMCOVERAGE differ. Keep the two files in step — a
//   selector present in one and missing from the other means that process
//   silently falls back to the 1-core / 2 GB generic default set in
//   nextflow.config. In particular `.*FASTQC`, not `FASTQC`: FASTQC is only ever
//   included under its eight aliases, so a bare selector would match nothing.

executor {
    cpus   = 128
    memory = '240.GB'   // NOT 256: this is the ADMISSION budget, so 256 would let
                        // Nextflow admit tasks summing to the node's entire
                        // physical RAM, leaving nothing for the Nextflow JVM, the
                        // OS, or the page cache each STAR reads its ~27 GB index
                        // through. 240 keeps the 4 x 48 = 192 GB STAR budget
                        // intact and still leaves 48 GB for everything else.
}

process {
    executor = 'local'

    // Hard ceiling on any request, including the retry escalation below. Must
    // track the `executor` block above.
    resourceLimits = [ cpus: 128, memory: 240.GB ]

    // Run tasks on the node-local SSD instead of BeeGFS $SCRATCH. STAR writes
    // its sort temp (and, if 2-pass is ever re-enabled, a regenerated ~27 GB
    // _STARgenome) into the task dir, which is a lot of parallel-filesystem
    // traffic for data that is thrown away. /tmp is 288 GB and purged at job
    // completion, so it cleans itself up.
    //
    // NOT YET VALIDATED under -profile apptainer,lonestar6: confirm /tmp is
    // bind-mounted (apptainer.autoMounts = true should cover it) and that four
    // concurrent STAR work dirs plus intermediates fit inside 288 GB.
    scratch = '/tmp'

    // ── Mid-tier: threaded samtools + QC ────────────────────────────────────
    withName: 'SAMTOOLS_QPASS|SAMTOOLS_MERGE|SPLIT_STRANDED_BAM|SPLIT_DEDUP_BAM|RFC_EXTRACT_DEDUP_READS|.*FASTQC' {
        cpus   = 4
        memory = '8.GB'
    }

    // ── cutadapt: both the ribo-seq and RNA-seq clip steps ──────────────────
    // 2 GB: measured peak RSS 0.24 GB at full depth. maxForks = 12 spends the
    // node on clipping many libraries at once (12 x 4 = 48 cores).
    withName: 'CUTADAPT_CLIP|CUTADAPT_CLIP_RNASEQ' {
        cpus     = 4
        memory   = '2.GB'
        maxForks = 12
    }

    // ── UMI extraction ──────────────────────────────────────────────────────
    // The largest consumer of total task time (14.0%, mean 194 s/task) and
    // strictly single-threaded — `umi_tools extract` has no threading option, it
    // measured 1.06 cores / 132 MB RSS, and most of its time goes to compressing
    // output through Python's `gzip` module. Concurrency is the ONLY lever this
    // profile has on it, hence maxForks = 16 (16 x 1 = 16 cores, 32 GB). Note
    // that 16 concurrent tasks each still take ~194 s; this raises throughput,
    // it does not make any single extraction faster.
    withName: 'UMITOOLS_EXTRACT' {
        cpus     = 1
        memory   = '2.GB'
        maxForks = 16
    }

    // ── bowtie2: all four paths (filter + transcriptome, ribo + RNA-seq) ────
    // 8, not 16: the four selectors measured 7.98-8.87 cores against an 8-core
    // request, i.e. saturated at 8, and 16 is untested. bowtie2 caps internally
    // at 16 threads and its piped samtools sort at 8, so the old 32 was always
    // waste. Extra alignment threads are also unlikely to pay off while the
    // modules feed the aligner through a single serial `gzip -dc`.
    // maxForks = 8 spends the freed cores on concurrency instead (8 x 8 = 64),
    // which is the principle this whole profile is built on.
    withName: 'BOWTIE2_FILTER|BOWTIE2_FILTER_RNASEQ|BOWTIE2_TRANSCRIPTOME|BOWTIE2_TRANSCRIPTOME_RNASEQ' {
        cpus     = 8
        memory   = '8.GB'
        maxForks = 8
    }

    // ── STAR alignment ──────────────────────────────────────────────────────
    // Four concurrent alignments: 4 x 8 = 32 cores and 4 x 48 = 192 GB, leaving
    // 96 cores and 48 GB for preprocessing, bowtie2, dedup and reporting.
    //
    // NOT five: 5 x 48 = 240 GB would consume the whole admission pool and leave
    // nothing for any other task, making the workflow prone to scheduling stalls.
    // Memory, not CPU, is what caps STAR concurrency here — which is exactly why
    // each STAR gets 8 cores rather than more.
    //
    // 48 GB is not trimmed toward the 31.65 GB measured peak: see the TUNING note
    // in conf/default.config. The ~27 GB figure is reference-specific and the
    // docker profile enforces the limit.
    //
    // NOT YET VALIDATED: each STAR process loads the ~27 GB index independently,
    // so four of them hold ~108 GB resident at once. The reservations fit, but
    // confirm it with one excluded pilot on a real node before trusting this for
    // a production sweep, and check whether I/O contention eats the gain. This
    // duplication is the largest remaining inefficiency in this profile;
    // scratch = '/tmp' above reduces the I/O cost of LOADING the index, not the
    // RAM cost of holding four copies. --genomeLoad LoadAndKeep would fix it but
    // is deliberately not used (leaked SysV segments, no sharing under Docker's
    // private IPC namespace, unusable on macOS).
    withName: 'STAR_ALIGN|STAR_ALIGN_RNASEQ' {
        cpus     = 8
        memory   = '48.GB'
        maxForks = 4
    }

    // Index generation runs once and benefits from headroom; keep it exclusive.
    // The only place this profile widens a task rather than multiplying it,
    // because there is nothing to run it concurrently with.
    withName: '.*STAR_INDEX' {
        cpus     = 32
        memory   = '64.GB'
        maxForks = 1
    }

    // ── UMI-aware dedup ─────────────────────────────────────────────────────
    // 8 GB against a measured max peak RSS of 4.34 GB, with the heap capped at
    // 6g to MATCH — see the long note in conf/default.config for why the
    // reservation and -Xmx must move together. maxForks = 6 (6 x 8 = 48 GB) lets
    // dedup for several samples overlap each other and STAR; Nextflow's memory
    // admission bounds the combination against the 240 GB pool automatically.
    //
    // algo=cc: TACC caps the process stack hard limit, so '--algo dir'
    // (recursive DFS) stack-overflows on large UMI graphs; cc is iterative
    // union-find. Do not drop this — it is a fix, not a preference.
    //
    // `memory` is a closure so a retry escalates it — declared here rather than in
    // nextflow.config because a base-config `withName` would be overridden by this
    // selector, silently replacing the closure with a literal.
    withName: 'UMICOLLAPSE_DEDUP' {
        cpus         = 4
        memory       = { 8.GB * task.attempt }
        maxForks     = 6
        ext.algo     = 'cc'
        ext.jvm_opts = '-Xms512m -Xmx6g -Xss256m'
    }

    // RIBOPY_CREATE holds one coverage array per read length and is the only
    // ribopy process that reads task.cpus (ribopy_create.nf:46). 16 GB against a
    // measured 8.83 GB peak; maxForks = 4 keeps it to 64 GB.
    withName: 'RIBOPY_CREATE' {
        cpus     = 4
        memory   = { 16.GB * task.attempt }
        maxForks = 4
    }

    // Split from RIBOPY_CREATE: measured 0.03 GB and 0.29 GB peak RSS, and
    // neither reads task.cpus, so their core count only gates admission.
    withName: 'RIBOPY_MERGE|RIBOPY_RNASEQ_SET' {
        cpus   = 4
        memory = '4.GB'
    }

    // bamCoverage forks N python workers; the module caps -p at min(cpus, 8).
    // Only active with do_bigwig: true, hence unmeasured — but MUST stay
    // declared or it falls to 1 core / 2 GB when switched on.
    withName: '.*DEEPTOOLS_BAMCOVERAGE' {
        cpus   = 8
        memory = '16.GB'
    }

    // Deliberately NOT declared, matching conf/default.config: RFC_DEDUP,
    // SEPARATE_BED, and the BAM_TO_BED / CONCAT_SORT_BED families. None reads
    // task.cpus and peak RSS is <= 0.02 GB, so the generic 1 core / 2 GB in
    // nextflow.config is correct and maximises concurrency.

    // ── Subworkflow-scoped overrides, last ──────────────────────────────────
    // Only active with star.output_transcriptome_bam: true, hence unmeasured.
    // The `.*:` prefix is REQUIRED — the qualified name is
    // RIBOFLOW:STAR_TRANSCRIPTOME_DEDUP:<PROC>, and the un-prefixed selectors
    // these replace never fired.
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SAMTOOLS_QPASS'          { cpus = 4; memory = '8.GB' }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SAMTOOLS_MERGE'          { cpus = 4; memory = '8.GB' }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SPLIT_DEDUP_BAM'         { cpus = 4; memory = '8.GB' }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:RFC_EXTRACT_DEDUP_READS' { cpus = 4; memory = '8.GB' }
}
