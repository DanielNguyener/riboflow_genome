// Default resource budget: a workstation, laptop or small server with
// 16 cores / 64 GB RAM.
//
// Use with: -profile default  |  -profile conda,default
//           -profile apptainer,default  |  -profile docker,default
// Also applied automatically when no -profile is given (see the `standard`
// profile in nextflow.config).
//
// DESIGN PRINCIPLE
//   A larger allocation should primarily buy more task CONCURRENCY, not more
//   threads per task. For human STAR alignment, MEMORY — not CPU — is the
//   limiting resource: the resident GRCh38 index is ~27 GB regardless of thread
//   count (measured peak 31.65 GB at full depth). So STAR's 48 GB reservation,
//   not its core count, is what decides how much else can run alongside it.
//
//   Concretely here: STAR reserves 48 of 64 GB, leaving 16 GB — enough for one
//   8 GB UMICOLLAPSE_DEDUP plus small tasks. Giving STAR 8 of 16 cores leaves 8
//   cores free for exactly that overlap. Widening STAR to 16 cores would reserve
//   the whole node's CPU for a process memory has already serialised, so nothing
//   could overlap it on either axis.
//
// TUNING
//   `executor.memory` must be >= the largest per-process `memory` below, or the
//   local executor can never schedule that task and aborts it (exit status `-`,
//   empty output). So if you lower the pool for a smaller machine, lower
//   STAR_ALIGN / STAR_ALIGN_RNASEQ / STAR_INDEX with it.
//   A full human STAR index is ~27 GB resident, so below ~32 GB of RAM you
//   cannot align a full human genome locally at all — use a bigger node
//   (conf/lonestar6.config) or a smaller reference such as the chr1 index built by
//   example_chr1_build_index.yaml.
//
//   Do NOT trim STAR's 48 GB toward its measured 31.65 GB peak. That peak is
//   specific to this GRCh38 build at sjdbOverhang 100; a larger reference or a
//   bigger overhang needs more, and under -profile docker the reservation is an
//   enforced cgroup limit, so an OOM kill is the failure mode. The apparent
//   slack is deliberate insurance on the one process where RAM, not CPU, is the
//   real requirement.
//
// SELECTOR ORDER
//   Broad groups first, specific process names after, subworkflow-scoped
//   overrides last. Nextflow prefers the most specific matching selector, and
//   among equally specific `withName` selectors the last declared one wins.
//
// SELECTOR MATCHING
//   `withName` values are anchored full-name regexes matched against either the
//   simple process name or the fully-qualified one. `CUTADAPT_CLIP` therefore
//   does NOT match `CUTADAPT_CLIP_RNASEQ`, and a qualified pattern must cover
//   the whole qualified name (hence the `.*:` prefixes at the bottom). Aliased
//   processes are matched by their ALIAS, not their module name — FASTQC is only
//   ever included as RAW_FASTQC / CLIPPED_FASTQC / ..., so a bare
//   `withName: 'FASTQC'` would match NOTHING and all eight aliases would
//   silently fall through to the 1-core / 2 GB generic default. Hence `.*FASTQC`.

executor {
    cpus   = 16
    memory = '64.GB'
}

process {
    executor = 'local'

    // Hard ceiling on any request, including the retry escalation below. Must
    // track the `executor` block above.
    resourceLimits = [ cpus: 16, memory: 64.GB ]

    // ── Mid-tier: threaded samtools + QC ────────────────────────────────────
    // These all consume task.cpus (samtools -@ / fastqc -t).
    // `.*FASTQC` covers the eight FASTQC aliases — see SELECTOR MATCHING above.
    withName: 'SAMTOOLS_QPASS|SAMTOOLS_MERGE|SPLIT_STRANDED_BAM|SPLIT_DEDUP_BAM|RFC_EXTRACT_DEDUP_READS|.*FASTQC' {
        cpus   = 4
        memory = '8.GB'
    }

    // ── cutadapt: both the ribo-seq and RNA-seq clip steps ──────────────────
    // 2 GB, not 4: measured peak RSS is 0.24 GB at full depth.
    //
    // The 4-core request is kept even though CUTADAPT_CLIP_RNASEQ measured only
    // 1.27 cores (4307 wasted core-seconds, the third-largest waste in the run).
    // That shortfall is NOT an oversized request: the SE branch of
    // cutadapt_clip_rnaseq.nf writes reads to stdout uncompressed and pipes them
    // through a single `gzip -c`, which bypasses cutadapt's own parallel
    // compression entirely and caps the whole step at ~1 core. Shrinking this
    // reservation to 2 would make the efficiency column look better while making
    // the step no faster; the module is what limits it. Left at 4 so the
    // reservation still reflects what cutadapt can use once that is addressed.
    withName: 'CUTADAPT_CLIP|CUTADAPT_CLIP_RNASEQ' {
        cpus   = 4
        memory = '2.GB'
    }

    // ── UMI extraction ──────────────────────────────────────────────────────
    // Declared explicitly rather than left to the generic default, because this
    // is the single largest consumer of total task time (1749 s, 14.0%, mean
    // 194 s/task at full depth — more than STAR_ALIGN's 12.2%) and a reader
    // scanning this file would otherwise assume the big reservations are where
    // the time goes.
    //
    // 1 core / 2 GB is CORRECT and cannot be improved here: measured 1.06 cores
    // and 132 MB RSS, and `umi_tools extract` has no threading option. Most of
    // its cost is compressing output through Python's `gzip` module
    // (umitools_extract.nf writes -S <file>.gz directly). No value in this file
    // can change that — it is a module-level limit, recorded here so the step is
    // not mistaken for a resource-config problem.
    withName: 'UMITOOLS_EXTRACT' {
        cpus   = 1
        memory = '2.GB'
    }

    // ── bowtie2: all four paths (filter + transcriptome, ribo + RNA-seq) ────
    // 8 cores is measured-saturated: all four selectors hit 7.98-8.87 cores
    // against an 8-core request at full depth. bowtie2 caps internally at 16
    // threads and its piped samtools sort at 8 (see modules/local/bowtie2_*.nf),
    // so going above 16 is always waste. Whether 16 would beat 8 is untested, and
    // is likely limited anyway: the modules feed the aligner through a single
    // `gzip -dc` process substitution, so input decompression is serial.
    withName: 'BOWTIE2_FILTER|BOWTIE2_FILTER_RNASEQ|BOWTIE2_TRANSCRIPTOME|BOWTIE2_TRANSCRIPTOME_RNASEQ' {
        cpus   = 8
        memory = '8.GB'
    }

    // ── STAR alignment ──────────────────────────────────────────────────────
    // 48 GB covers the ~27 GB resident index plus the coordinate sort
    // (--limitBAMsortRAM is derived as task.memory - 30 GiB, so 18 GiB here —
    // see modules/local/star_align.nf). See TUNING above for why this is not
    // trimmed toward the 31.65 GB measured peak.
    //
    // 8 cores, not 16: memory already serialises STAR here (2 x 48 > 64 GB), so
    // the leftover cores are the only thing a lower count buys — and they let
    // UMICOLLAPSE_DEDUP (4 cores / 8 GB) run alongside. 8 + 4 = 12 of 16 cores
    // and 48 + 8 = 56 of 64 GB, so both fit with room for the 1-core steps.
    // maxForks = 1 is redundant against the memory pool but kept to document
    // the intent.
    withName: 'STAR_ALIGN|STAR_ALIGN_RNASEQ' {
        cpus     = 8
        memory   = '48.GB'
        maxForks = 1
    }

    // Index generation needs the same order of memory as alignment. Runs once
    // (storeDir-cached, see conf/modules.config) and only in build-from-FASTA
    // mode. MUST stay declared — without it this falls to 1 core / 2 GB and
    // fails outright.
    withName: 'STAR_INDEX' {
        cpus     = 8
        memory   = '48.GB'
        maxForks = 1
    }

    // ── UMI-aware dedup ─────────────────────────────────────────────────────
    // 8 GB against a measured max peak RSS of 4.34 GB at full depth (~1.8x).
    //
    // ext.jvm_opts caps the heap at 6g to MATCH that reservation. This pairing
    // is the whole point: `memory` is only a scheduling reservation under the
    // local executor, not an enforced cap, so an 8 GB reservation left against
    // the module's default -Xmx32g heap (modules/local/umicollapse_dedup.nf)
    // would be a reservation the JVM could silently blow straight through — the
    // host would swap rather than fail loudly. Reserve and cap together, or
    // neither. If a pathological library ever needs more, raise BOTH; note
    // nextflow.config also escalates this reservation on retry.
    //
    // algo=cc: '--algo dir' is a recursive DFS that overflows the JVM stack on
    // hosts with a hard stack rlimit (TACC); cc is iterative union-find. Do not
    // drop this — it is a fix, not a preference.
    //
    // `memory` is a closure so a retry escalates it (see the RETRY CONTRACT note
    // in nextflow.config). It is declared here rather than there because a
    // `withName` selector in the base config would be overridden by this one —
    // base value and escalation have to live together or the closure is silently
    // replaced by a literal. Note the heap stays at 6g on retry: if 8 GB was not
    // enough the fix is a bigger heap too, so a second failure is informative
    // rather than an endless climb.
    withName: 'UMICOLLAPSE_DEDUP' {
        cpus         = 4
        memory       = { 8.GB * task.attempt }
        ext.algo     = 'cc'
        ext.jvm_opts = '-Xms512m -Xmx6g -Xss256m'
    }

    // RIBOPY_CREATE is the one real memory consumer besides STAR — with
    // coverage: true it holds one array per read length — and the only ribopy
    // process that reads task.cpus (ribopy_create.nf:46, `-n ${task.cpus}`).
    // 16 GB against a measured 8.83 GB peak, escalating on retry.
    withName: 'RIBOPY_CREATE' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
    }

    // Split from RIBOPY_CREATE: measured 0.03 GB and 0.29 GB peak RSS, and
    // NEITHER reads task.cpus, so their core count only gates admission.
    // Sharing CREATE's 32 GB reservation (what this used to do) made two
    // trivial processes each block half the pool for nothing.
    withName: 'RIBOPY_MERGE|RIBOPY_RNASEQ_SET' {
        cpus   = 4
        memory = '4.GB'
    }

    // bamCoverage forks N python workers; the module caps -p at min(cpus, 8).
    // Only active with do_bigwig: true, hence unmeasured — but MUST stay
    // declared or it falls to 1 core / 2 GB when switched on.
    withName: 'DEEPTOOLS_BAMCOVERAGE' {
        cpus   = 4
        memory = '8.GB'
    }

    // Deliberately NOT declared: RFC_DEDUP, SEPARATE_BED, and the BAM_TO_BED /
    // CONCAT_SORT_BED families (plus their 14 aliases). None of those modules
    // reads task.cpus at all and their peak RSS is <= 0.02 GB, so
    // nextflow.config's generic 1 core / 2 GB is already the right answer. Same
    // for the ~20 stats/publishing steps. Sizing them would only cut concurrency.

    // ── Subworkflow-scoped overrides, last ──────────────────────────────────
    // Only active with star.output_transcriptome_bam: true, hence unmeasured.
    // The `.*:` prefix is REQUIRED: the qualified name is
    // RIBOFLOW:STAR_TRANSCRIPTOME_DEDUP:<PROC>, and a qualified selector must
    // match the whole qualified name. The un-prefixed selectors these replace
    // never fired. Compare conf/modules.config, which prefixes correctly.
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SAMTOOLS_QPASS'          { cpus = 4; memory = '8.GB' }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SAMTOOLS_MERGE'          { cpus = 4; memory = '8.GB' }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SPLIT_DEDUP_BAM'         { cpus = 4; memory = '8.GB' }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:RFC_EXTRACT_DEDUP_READS' { cpus = 4; memory = '8.GB' }
}
