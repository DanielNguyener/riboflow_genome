// RiboFlow (genome) — DSL2.
nextflow.enable.dsl = 2

manifest {
    name            = 'riboflow_genome'
    homePage        = 'https://github.com/DanielNguyener/riboflow_genome'
    description     = 'Ribosome-profiling genome alignment pipeline (DSL2, nf-core layout).'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.0.0'
    version         = '0.0.2'
}

// Pipeline-level parameter defaults. Test/example YAMLs override these.
params {
    genome = [
        run:                    true,   // set false to skip genome alignment (transcriptome.run must then be true)
        mapping_quality_cutoff: 255,    // STAR: 255=unique only; <255=include multi-mappers
        ribo_filter_flags:      2308    // 2308 = unmapped(4) + secondary(256) + supplementary(2048)
    ]

    transcriptome = [
        run:                    false,
        mapping_quality_cutoff: 10    // bowtie2: 10=confident; 20=more strict; 40=unique only
    ]

    // bowtie2 alignment arguments for the filter and transcriptome paths.
    // genome is not listed — STAR genome alignment is configured via star.ribo_arguments.
    alignment_arguments = [
        filter:        '-L 15 --no-unal --norc',
        transcriptome: '-L 15 --no-unal --norc'
    ]

    ribo = [
        ref_name:        'appris_human',
        metagene_radius: 50,
        left_span:       35,
        right_span:      15,
        read_length:     [ min: 15, max: 35 ],
        coverage:        true
        // Optional metadata embedded into .ribo files via ribopy create:
        //   ribometa: ./params.yaml           — global experiment metadata (same file for all samples)
        //   metadata:                          — per-sample expmeta (different file per sample)
        //     base: ""                         — optional path prefix
        //     files:
        //       sample1: meta/sample1.yaml
        //       sample2: meta/sample2.yaml
    ]

    // STAR per-path arguments. ribo_arguments applies to the ribo-seq genome
    // alignment; rnaseq_arguments to the RNA-seq genome alignment. Override in
    // example YAMLs. Defaults are empty / ENCODE PE flags respectively.
    // STAR index generation params (build-from-FASTA mode).
    // Set input.reference.genome_fasta + input.reference.gtf in your YAML to
    // trigger index generation. Leave unset to use a pre-built index directory
    // at input.reference.genome (the default).
    //   sjdb_overhang: read_length - 1 (STAR default 100; use 28 for short ribo-seq)
    //   index_dir:     persistent storeDir for the built index (optional; defaults to
    //                  intermediates/star_index if unset)
    star = [
        output_transcriptome_bam: false,
        ribo_arguments:   '',
        rnaseq_arguments: '--outFilterType BySJout --outFilterMultimapNmax 20 --alignSJoverhangMin 8 --alignSJDBoverhangMin 1 --outFilterMismatchNmax 999 --outFilterMismatchNoverReadLmax 0.04 --alignIntronMin 20 --alignIntronMax 1000000 --alignMatesGapMax 1000000',
        sjdb_overhang:    100,   // override in YAML: star.sjdb_overhang: 28
        index_args:       ''     // extra genomeGenerate flags; e.g. '--genomeSAindexNbases 7' for small genomes
    ]

    // RNA-seq path (off by default). Separate FASTQs, clip/filter/dedup params
    // from the ribo-seq path; shares the bowtie2 filter + genome/transcriptome refs.
    do_rnaseq = false

    // Generate strand-specific bigWig coverage tracks for genome alignments
    // (ribo-seq + RNA-seq). Off by default — deepTools bamCoverage is expensive.
    do_bigwig = false

    rnaseq = [
        fastq_base:                  '',
        clip_arguments:              '-u 1 --quality-cutoff=28 --minimum-length=20',
        filter_arguments:            '-L 15 --no-unal',
        dedup_method:                'none',
        umi_tools_extract_arguments: '',
        genome:       [ mapping_quality_cutoff: 4,  filter_flags: 2308 ],
        transcriptome:[ mapping_quality_cutoff: 10, alignment_arguments: '-L 15 --no-unal' ]
    ]
}

// Per-module storeDir/publishDir/ext.args. Per-tool RESOURCES live in the resource
// profiles below (conf/default.config, conf/lonestar6.config).
includeConfig 'conf/modules.config'

// Generic process defaults + retry policy, applied to every run.
//
// The generic cpus/memory deliberately describe the SMALLEST task in the pipeline,
// not the average one. They apply only to processes with no explicit `withName`
// selector in the active resource profile — the stats, publishing, correspondence
// and UMI-extraction steps, none of which reads `task.cpus` at all. A generic
// 10-core / 16 GB reservation (what this used to be) caps whole-run concurrency at
// min(executor.cpus / 10, executor.memory / 16GB), i.e. 1-3 tasks however large the
// machine is. Anything that genuinely uses cores or memory is sized explicitly in
// the resource profile.
// RETRY CONTRACT
//   `errorStrategy = 'retry'` with a STATIC `memory` is a trap: a task killed for
//   running out of memory retries with the identical reservation and is guaranteed
//   to fail again, having paid the full cost of the re-run twice. And retrying
//   unconditionally re-runs deterministic failures (bad data, a syntax error) that
//   cannot succeed on a second attempt.
//
//   So: retry only on statuses that plausibly succeed on a retry — 137/140 are
//   OOM kills, 134/139 aborts/segfaults, 143 SIGTERM, 104/247 transient I/O — and
//   escalate `memory` with `task.attempt` on the memory-sensitive processes.
//
//   That escalation is declared in the RESOURCE PROFILES (conf/default.config,
//   conf/lonestar6.config), not here, and deliberately so: a `withName` selector
//   in this file would be overridden by the same selector in a profile, because
//   profiles merge after the base config. Base and escalation must be declared
//   together or the closure is silently replaced by a literal. `resourceLimits`,
//   also set per profile, clamps the escalation to what the machine has.
//
//   CAVEAT, stated rather than implied: only the docker profile ENFORCES `memory`
//   (Nextflow passes --memory). Under conda and apptainer a reservation is only an
//   admission hint, so an over-running task swaps instead of being killed — it
//   never produces an exit status for this to catch. Escalation rescues the docker
//   profile; on the others the reservation/heap pairing in the resource profiles
//   is what keeps usage honest.
//
//   Second caveat: deterministic failures now TERMINATE rather than silently
//   retrying once. That is the intent, but it also means a transient BeeGFS hiccup
//   on LS6 no longer retries. Add `errorStrategy = 'retry'` back for a specific
//   process if that bites.
process {
    cpus          = 1
    memory        = '2.GB'
    maxRetries    = 2
    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'terminate' }
    shell         = ['/bin/bash', '-uexo', 'pipefail']
}

// There are two independent axes: WHERE the tools come from (env profile) and HOW
// BIG the machine is (resource profile). Combine one of each with a comma:
//
//   RESOURCE   default     16 cores / 64 GB — workstation, laptop, small server
//              lonestar6   full TACC Lonestar6 node (128 cores / 256 GB)
//              test        tiny stub fixtures, for -stub-run wiring checks
//
//   ENV        conda       Nextflow builds and manages environment.yaml
//              apptainer   everything runs in the Apptainer image
//              docker      everything runs in the Docker image
//              (omit)      ambient tools already on PATH
//
//   -profile conda,default          conda env on a workstation
//   -profile docker,default         Docker on a workstation
//   -profile conda,lonestar6        LS6 with the conda env
//   -profile apptainer,lonestar6    LS6 with the Apptainer image
//   -profile default                ambient tools on a workstation
//
// `default` is applied automatically when no resource profile is named (see the
// `standard` profile below), so `-profile conda` alone and a bare `nextflow run`
// are still correctly sized.
//
// The former `local`, `ambient` and `ls6` profiles have been REMOVED. Use `default`
// for `local`/`ambient` and `lonestar6` for `ls6`.

profiles {

    // ── Resource profiles ─────────────────────────────────────────────────────
    // Workstation / laptop / small server. See conf/default.config to tune.
    // Quoted because `default` is a Groovy reserved word — bare `default {` is a
    // parse error. `-profile default` selects it normally.
    'default' {
        includeConfig 'conf/default.config'
    }

    // Full TACC Lonestar6 compute node. See conf/lonestar6.config to tune.
    lonestar6 {
        includeConfig 'conf/lonestar6.config'
    }

    // Applied by Nextflow when -profile is omitted, so a bare run and an env-only
    // selection such as `-profile conda` still get real resource sizes instead of
    // the 1-core / 2 GB lightweight generic set above. Not a fourth user-facing
    // profile — it exists so `default` is genuinely the default.
    standard {
        includeConfig 'conf/default.config'
    }

    // ── Environment / container profiles ─────────────────────────────────────
    // These set environment/container options ONLY — never resources — so they
    // compose cleanly with any resource profile.

    // Let Nextflow build and manage the single consolidated conda env.
    // Pair with a resource profile: -profile conda,default  or  conda,lonestar6
    conda {
        conda.enabled  = true
        conda.channels = ['conda-forge', 'bioconda']
        process.conda  = "${projectDir}/environment.yaml"
        // Build the env in the repo (instead of <runDir>/work/conda), so it
        // survives `rm -rf work/` and is reused across runs rather than rebuilt.
        // Override with the NXF_CONDA_CACHEDIR env var for a shared location.
        conda.cacheDir = "${projectDir}/conda_cache"
    }

    // Run every process inside the consolidated Apptainer image (pulled from Docker Hub).
    // Pair with a resource profile: -profile apptainer,default  or  apptainer,lonestar6
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        // Cache the pulled .sif in the repo (instead of <runDir>/work/singularity),
        // so the image is fetched once and reused across runs. Override with the
        // NXF_APPTAINER_CACHEDIR env var if you prefer a shared/scratch location.
        apptainer.cacheDir   = "${projectDir}/apptainer_cache"
        process.container    = 'docker://danielnguyener/riboflow:0.0.2'
    }

    // Run every process inside the consolidated Docker image.
    // Pair with a resource profile: -profile docker,default  or  docker,lonestar6
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = 'danielnguyener/riboflow:0.0.2'
    }

    // Fast wiring check: stub-run the whole genome DAG with tiny fixtures.
    test {
        includeConfig 'conf/test.config'
    }
}

timeline { enabled = true; file = "./nextflow_logs/timeline.html"; overwrite = true }
trace    { enabled = true; file = "./nextflow_logs/trace.txt";    overwrite = true }
report   { enabled = true; file = "./nextflow_logs/report.html";  overwrite = true }
